{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ app.current_route|trans }}{% endblock %}

{% block body %}
<header class="navbar bg-body shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand font-monospace d-flex align-items-center" href="{{ path('homepage') }}">
            {{ ux_icon('streamline-freehand:stamps-portrait', {class: 'fs-3 me-2', fill: '#fd7e14'}) }} Post Office
