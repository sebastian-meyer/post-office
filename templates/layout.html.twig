{% extends 'base.html.twig' %}

{% block body %}
<header class="navbar navbar-expand-md bg-body-tertiary shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand font-monospace d-flex align-items-center" href="/">
            {{ ux_icon('streamline-freehand:stamps-portrait', {class: 'fs-3 me-2', fill: '#fd7e14'}) }} Post Office
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <nav class="collapse navbar-collapse justify-content-end" id="navigation">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        Homepage
                    </a>
                </li>
            </ul>
            {% if not is_granted('IS_AUTHENTICATED') %}
            <a class="btn btn-outline-primary" href="/login">
                {{ 'login'|trans }}
            </a>
            {% else %}
            <a class="btn btn-outline-danger" href="/logout">
                {{ 'logout'|trans }}
            </a>
            {% endif %}
        </nav>
    </div>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer>
{% block footer %}{% endblock %}
</footer>
{% endblock %}
