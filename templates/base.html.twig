<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="cache-control" content="no-cache">
        <meta name="robots" content="noindex,nofollow">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Don't let Turbo load pages when hovering links (GET links must not trigger actions by accident). #}
        <meta name="turbo-prefetch" content="false">
        <title>{% block title %}{{ app_name }}{% endblock %}</title>
        {% if app.current_route %}
        <link rel="canonical" href="{{ url(app.current_route, app.current_route_parameters) }}">
        {% endif %}
        {# The SVG is preferred, favicon.ico (16, 32 and 48 px) is for browsers without SVG support (e.g. Safari). #}
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="icon" href="{{ asset('icons/streamline-freehand/stamps-portrait.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% block stylesheets %}{% endblock %}
    </head>
    <body id="page-top" class="min-vh-100">

        {% block body %}{% endblock %}

        <!-- Confirmation Dialog (used by the "confirm" Stimulus controller) -->
        <div class="modal fade" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="confirm-modal-title">
                            {{ ux_icon('mdi:alert-outline', {class: 'text-danger me-2'}) }}{{ 'confirmTitle'|trans }}
                        </h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'close'|trans }}"></button>
                    </div>
                    <div class="modal-body" data-confirm-modal-message></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-confirm-modal-cancel>{{ 'cancel'|trans }}</button>
                        <button type="button" class="btn btn-danger" data-confirm-modal-accept data-label="{{ 'delete'|trans }}"></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll to Top Button -->
        <a class="btn btn-outline-secondary scroll-to-top" href="#page-top" role="button">
            {{ ux_icon('tabler:chevrons-up') }}
        </a>
    </body>
</html>
