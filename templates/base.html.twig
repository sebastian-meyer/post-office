<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Post Office{% endblock %}</title>
        <link rel="icon" href="{{ asset('icons/symfony.svg') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body id="page-top">

        {% block body %}{% endblock %}

        <!-- Scroll to Top Button -->
        <a class="btn btn-outline-secondary scroll-to-top" href="#page-top" role="button">
            {{ ux_icon('tabler:chevrons-up') }}
        </a>
    </body>
</html>
