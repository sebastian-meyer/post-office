<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="cache-control" content="no-cache">
        <meta name="robots" content="noindex,nofollow">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Don't let Turbo load pages when hovering links (GET links must not trigger actions by accident). #}
        <meta name="turbo-prefetch" content="false">
        <title>{% block title %}{{ app_name }}{% endblock %}</title>
        {% if app.current_route %}
        <link rel="canonical" href="{{ url(app.current_route, app.current_route_parameters) }}">
        {% endif %}
        <link rel="icon" href="{{ asset('icons/streamline-freehand/stamps-portrait.svg') }}">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% block stylesheets %}{% endblock %}
    </head>
    <body id="page-top" class="min-vh-100">

        {% block body %}{% endblock %}

        <!-- Scroll to Top Button -->
        <a class="btn btn-outline-secondary scroll-to-top" href="#page-top" role="button">
            {{ ux_icon('tabler:chevrons-up') }}
        </a>
    </body>
</html>
