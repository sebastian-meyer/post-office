{% extends 'layout.html.twig' %}

{% block content %}
<div class="container py-4">
    <div class="card bg-body-tertiary shadow-sm mx-auto" style="max-width: 40rem;">
        <div class="card-header">
            <h1 class="h4 mb-0">{{ 'account'|trans }}</h1>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">{{ 'email'|trans }}</dt>
                <dd class="col-sm-8 font-monospace">{{ account.userIdentifier }}</dd>

                {% if account.label is not empty %}
                <dt class="col-sm-4">{{ 'label'|trans }}</dt>
                <dd class="col-sm-8">{{ account.label }}</dd>
                {% endif %}

                <dt class="col-sm-4">{{ 'accountType'|trans }}</dt>
                <dd class="col-sm-8">{{ ('accountType.' ~ account.type.value)|trans }}</dd>

                {% if account.mailbox %}
                <dt class="col-sm-4">{{ 'quota'|trans }}</dt>
                <dd class="col-sm-8">
                    {% if account.quota == 0 %}{{ 'quotaUnlimited'|trans }}{% else %}{{ 'quotaMegabytes'|trans({'%quota%': account.quota}) }}{% endif %}
                </dd>
                {% endif %}
            </dl>
        </div>
        <div class="card-footer">
            <a class="btn btn-primary" href="{{ path('change_password') }}">{{ ux_icon('mdi:password-reset', {class: 'fs-4 me-1'}) }} {{ 'changePassword'|trans }}</a>
        </div>
    </div>
</div>
{% endblock %}
