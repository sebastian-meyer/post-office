{% extends 'layout.html.twig' %}

{% import 'macros/datatable.html.twig' as datatable %}

{% block content %}
<div class="container py-4">
    <div class="card shadow-sm mx-auto mb-4" style="max-width: 40rem;">
        <div class="card-header">
            <h1 class="h4 mb-0">{{ 'account'|trans }}</h1>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">{{ 'email'|trans }}</dt>
                <dd class="col-sm-8 font-monospace">{{ account.userIdentifier }}</dd>

                <dt class="col-sm-4">{{ form_label(labelForm.label) }}</dt>
                <dd class="col-sm-8">
                    {{ form_start(labelForm) }}
                    <div class="input-group input-group-sm has-validation">
                        {{ form_widget(labelForm.label, {attr: {placeholder: 'labelPlaceholder'}}) }}
                        <button type="submit" class="btn btn-outline-primary">
                            {{ ux_icon('mdi:content-save', {class: 'me-1'}) }} {{ 'save'|trans }}
                        </button>
                        {{ form_errors(labelForm.label) }}
                    </div>
                    {{ form_end(labelForm) }}
                </dd>

                <dt class="col-sm-4">{{ 'accountType'|trans }}</dt>
                <dd class="col-sm-8">{{ ('accountType.' ~ account.type.value)|trans }}</dd>

                {% if account.mailbox %}
                <dt class="col-sm-4">{{ 'quota'|trans }}</dt>
                <dd class="col-sm-8">
                    {% if account.quota == 0 %}{{ 'quotaUnlimited'|trans }}{% else %}{{ 'quotaMegabytes'|trans({'%quota%': account.quota}) }}{% endif %}
                </dd>
                {% endif %}
            </dl>
        </div>
        <div class="card-footer">
            <a class="btn btn-primary" href="{{ path('change_password') }}">{{ ux_icon('mdi:password-reset', {class: 'fs-4 me-1'}) }} {{ 'changePassword'|trans }}</a>
        </div>
    </div>

    {% if memberships is not empty %}
    <div class="card shadow-sm mx-auto" style="max-width: 60rem;">
        <div class="card-header">
            <h2 class="h5 mb-0">{{ 'myMailingLists'|trans }}</h2>
        </div>
        <div class="card-body">
            <p class="text-body-secondary">{{ 'myMailingListsHelp'|trans }}</p>
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'address'|trans }}</th>
                            <th>{{ 'label'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for list in memberships %}
                        <tr>
                            <td class="font-monospace">{{ list.userIdentifier }}</td>
                            <td>{{ list.label }}</td>
                            <td class="text-end">{{ include('account/_leave_list_button.html.twig') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
