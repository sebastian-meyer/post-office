{% extends 'layout.html.twig' %}

{% import 'macros/datatable.html.twig' as datatable %}

{% block title %}{{ app_name }} - {{ 'tlsPolicies'|trans }}{% endblock %}

{% block content %}
<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('manage') }}">{{ 'manage'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'tlsPolicies'|trans }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h1 class="h3 mb-0">{{ 'tlsPolicies'|trans }}</h1>
        <a class="btn btn-primary" href="{{ path('admin_tls_policy_new') }}">
            {{ ux_icon('mdi:plus', {class: 'me-1'}) }} {{ 'newTlsPolicy'|trans }}
        </a>
    </div>
    <p class="text-body-secondary mb-4">{{ 'tlsPoliciesHelp'|trans }}</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'recipientDomain'|trans }}</th>
                            <th>{{ 'tlsPolicy'|trans }}</th>
                            <th>{{ 'tlsParams'|trans }}</th>
                            <th>{{ 'status'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for policy in policies %}
                        <tr>
                            <td class="font-monospace">{{ policy.domain }}</td>
                            <td class="font-monospace">{{ policy.policy }}</td>
                            <td class="font-monospace small">{{ policy.params }}</td>
                            <td>{{ include('components/status-toggle.html.twig', {enabled: policy.enabled, url: path('admin_tls_policy_toggle'), token: 'toggle-tls-policy-' ~ policy.domain, fields: {domain: policy.domain}}) }}</td>
                            <td class="text-end text-nowrap">
                                {{ include('admin/_actions.html.twig', {
                                    edit: path('admin_tls_policy_edit', {domain: policy.domain}),
                                    delete: path('admin_tls_policy_delete'),
                                    fields: {domain: policy.domain},
                                    token: 'delete-tls-policy-' ~ policy.domain,
                                    confirm: 'deleteTlsPolicyConfirm'|trans({'%domain%': policy.domain})
                                }) }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
