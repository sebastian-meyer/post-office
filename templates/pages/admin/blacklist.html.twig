{% extends 'layout.html.twig' %}

{% import 'macros/datatable.html.twig' as datatable %}

{% block title %}{{ app_name }} - {{ 'blacklist'|trans }}{% endblock %}

{% block content %}
<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('manage') }}">{{ 'manage'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'blacklist'|trans }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h1 class="h3 mb-0">{{ 'blacklist'|trans }}</h1>
        <a class="btn btn-primary" href="{{ path('admin_blacklist_new') }}">
            {{ ux_icon('mdi:plus', {class: 'me-1'}) }} {{ 'newBlacklistEntry'|trans }}
        </a>
    </div>
    <p class="text-body-secondary mb-4">{{ 'blacklistHelp'|trans }}</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'blacklistAddress'|trans }}</th>
                            <th>{{ 'blacklistAction'|trans }}</th>
                            <th>{{ 'status'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in entries %}
                        {% set address = entry.username is not null ? entry.username ~ '@' ~ entry.domain : entry.domain %}
                        <tr>
                            <td class="font-monospace">{{ address }}</td>
                            <td>{{ ('blacklistAction.' ~ entry.action)|trans }}</td>
                            <td>{{ include('components/status-toggle.html.twig', {enabled: entry.enabled, url: path('admin_blacklist_toggle', {id: entry.id}), token: 'toggle-blacklist-' ~ entry.id}) }}</td>
                            <td class="text-end text-nowrap">
                                {{ include('admin/_actions.html.twig', {
                                    edit: path('admin_blacklist_edit', {id: entry.id}),
                                    delete: path('admin_blacklist_delete', {id: entry.id}),
                                    token: 'delete-blacklist-' ~ entry.id,
                                    confirm: 'deleteBlacklistEntryConfirm'|trans({'%address%': address})
                                }) }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
