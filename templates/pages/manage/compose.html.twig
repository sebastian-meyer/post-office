{% extends 'layout.html.twig' %}

{% block title %}{{ app_name }} - {{ 'writeEmail'|trans }}{% endblock %}

{% block content %}
{% set recipients = form.recipients.children|filter(choice => choice.vars.checked) %}
<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('manage') }}">{{ 'manage'|trans }}</a></li>
            {% if is_granted('DOMAIN_MANAGE', domain) %}
            <li class="breadcrumb-item"><a class="font-monospace" href="{{ path('manage_domain', {domain: domain.domain}) }}">{{ domain }}</a></li>
            {% endif %}
            {% if list %}
            <li class="breadcrumb-item"><a class="font-monospace" href="{{ path('manage_list', {id: list.id}) }}">{{ list }}</a></li>
            {% endif %}
            <li class="breadcrumb-item active" aria-current="page">{{ 'writeEmail'|trans }}</li>
        </ol>
    </nav>

    <div class="card shadow-sm mx-auto" style="max-width: 50rem;">
        <div class="card-header">
            <h1 class="h4 mb-0">{{ 'writeEmail'|trans }}</h1>
        </div>
        {{ form_start(form) }}
        <div class="card-body">
            {% if skipped is not empty %}
            <div class="alert alert-warning">
                {{ 'recipientsSkipped'|trans({'%addresses%': skipped|join(', ')}) }}
            </div>
            {% endif %}

            <div class="mb-3">
                <div class="form-label">{{ 'sender'|trans }}</div>
                <div class="form-control-plaintext font-monospace py-0">
                    {% if sender.label %}{{ sender.label }} &lt;{{ sender.userIdentifier }}&gt;{% else %}{{ sender.userIdentifier }}{% endif %}
                </div>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">
                    {{ 'recipients'|trans }} <span class="badge text-bg-secondary">{{ recipients|length }}</span>
                </legend>
                {% if recipients is empty %}
                <div class="alert alert-warning mb-0">
                    {{ 'noRecipientsMarked'|trans }}
                    <a class="alert-link" href="{{ backUrl }}">{{ 'backToSelection'|trans }}</a>
                </div>
                {% else %}
                <div class="border rounded px-3 py-2 overflow-auto font-monospace" style="max-height: 12rem;">
                    {% for choice in recipients %}
                    {{ form_widget(choice) }}
                    {% endfor %}
                </div>
                <div class="form-text">{{ 'recipientsHelp'|trans }}</div>
                {% endif %}
                {{ form_errors(form.recipients) }}
                {% do form.recipients.setRendered() %}
            </fieldset>

            {{ form_rest(form) }}
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a class="btn btn-outline-secondary" href="{{ backUrl }}">
                {{ ux_icon('mdi:arrow-left', {class: 'me-1'}) }} {{ 'cancel'|trans }}
            </a>
            <button type="submit" class="btn btn-primary"{% if recipients is empty %} disabled{% endif %}>
                {{ ux_icon('mdi:send', {class: 'me-1'}) }} {{ 'sendEmail'|trans }}
            </button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
