{% extends 'layout.html.twig' %}

{% import 'macros/datatable.html.twig' as datatable %}

{% block title %}{{ app_name }} - {{ domain }}{% endblock %}

{% block content %}
<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('manage') }}">{{ 'manage'|trans }}</a></li>
            <li class="breadcrumb-item active font-monospace" aria-current="page">{{ domain }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0 font-monospace">{{ domain }}</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="{{ path('manage_account_new', {domain: domain.domain, type: 'mailbox'}) }}">
                {{ ux_icon('mdi:email-plus', {class: 'me-1'}) }} {{ 'newMailbox'|trans }}
            </a>
            <a class="btn btn-outline-primary" href="{{ path('manage_account_new', {domain: domain.domain, type: 'alias'}) }}">
                {{ ux_icon('mdi:email-arrow-right', {class: 'me-1'}) }} {{ 'newAlias'|trans }}
            </a>
            <a class="btn btn-outline-primary" href="{{ path('manage_account_new', {domain: domain.domain, type: 'list'}) }}">
                {{ ux_icon('mdi:email-multiple', {class: 'me-1'}) }} {{ 'newMailingList'|trans }}
            </a>
            <a class="btn btn-outline-primary" href="{{ path('manage_account_new', {domain: domain.domain, type: 'sendonly'}) }}">
                {{ ux_icon('mdi:send', {class: 'me-1'}) }} {{ 'newSendOnly'|trans }}
            </a>
        </div>
    </div>

    <div class="card bg-body-tertiary shadow-sm">
        <div class="card-body">
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'address'|trans }}</th>
                            <th>{{ 'accountType'|trans }}</th>
                            <th>{{ 'label'|trans }}</th>
                            <th class="text-end">{{ 'quota'|trans }}</th>
                            <th>{{ 'status'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for account in accounts %}
                        <tr>
                            <td class="font-monospace">
                                {{ account }}
                                {% if account.catchAll %}<span class="badge text-bg-secondary ms-1">{{ 'catchAll'|trans }}</span>{% endif %}
                                {% if is_admin_account(account) %}<span class="badge text-bg-primary ms-1">{{ 'administrator'|trans }}</span>{% endif %}
                            </td>
                            <td>{{ ('accountType.' ~ account.type.value)|trans }}</td>
                            <td>{{ account.label }}</td>
                            {% if account.mailbox %}
                            <td class="text-end" data-order="{{ account.quota == 0 ? 2147483647 : account.quota }}">
                                {% if account.quota == 0 %}{{ 'quotaUnlimited'|trans }}{% else %}{{ 'quotaMegabytes'|trans({'%quota%': account.quota}) }}{% endif %}
                            </td>
                            {% else %}
                            <td class="text-end" data-order="-1">–</td>
                            {% endif %}
                            <td>
                                {# Users cannot disable their own account (to prevent lock-outs). #}
                                {{ include('components/status-toggle.html.twig', {
                                    enabled: account.enabled,
                                    url: is_granted('ACCOUNT_MANAGE', account) and account.id != app.user.id ? path('manage_account_toggle', {id: account.id}) : null,
                                    token: 'toggle-account-' ~ account.id
                                }) }}
                            </td>
                            <td class="text-end text-nowrap">{{ include('manage/_account_actions.html.twig') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if is_granted('DOMAIN_MANAGE_MANAGERS', domain) %}
    <div class="card bg-body-tertiary shadow-sm mt-4">
        <div class="card-header">
            <h2 class="h5 mb-0">{{ 'domainManagers'|trans }}</h2>
        </div>
        <div class="card-body">
            <p class="text-body-secondary">{{ 'domainManagersHelp'|trans }}</p>
            {{ form_start(managerForm) }}
            <div class="input-group has-validation">
                {{ form_widget(managerForm.email, {attr: {placeholder: 'email'}}) }}
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('mdi:account-plus', {class: 'me-1'}) }} {{ 'addManager'|trans }}
                </button>
                {{ form_errors(managerForm.email) }}
            </div>
            <div class="form-text mb-3">{{ 'managerHelp'|trans }}</div>
            {{ form_end(managerForm) }}

            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'email'|trans }}</th>
                            <th>{{ 'label'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for manager in domain.managers %}
                        <tr>
                            <td class="font-monospace">{{ manager }}</td>
                            <td>{{ manager.label }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('manage_domain_manager_remove', {domain: domain.domain, manager: manager.id}) }}" class="d-inline"
                                      data-controller="confirm" data-action="confirm#ask"
                                      data-confirm-message-value="{{ 'removeDomainManagerConfirm'|trans({'%email%': manager ~ '', '%domain%': domain ~ ''}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove-domain-manager-' ~ domain.domain) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        {{ ux_icon('mdi:account-remove', {class: 'me-1'}) }} {{ 'remove'|trans }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
