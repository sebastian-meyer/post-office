{% extends 'layout.html.twig' %}

{% import 'macros/datatable.html.twig' as datatable %}

{% block content %}
<div class="container py-4">
    <h1 class="h3 mb-4">{{ 'manage'|trans }}</h1>

    {% if domains is not empty %}
    <div class="card bg-body-tertiary shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">{{ 'domains'|trans }}</h2>
        </div>
        <div class="card-body">
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'domain'|trans }}</th>
                            <th class="text-end">{{ 'accounts'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in domains %}
                        <tr>
                            <td class="font-monospace">{{ entry.domain }}</td>
                            <td class="text-end">{{ entry.accounts }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('manage_domain', {domain: entry.domain.domain}) }}">
                                    {{ ux_icon('mdi:domain', {class: 'me-1'}) }} {{ 'open'|trans }}
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {% if lists is not empty %}
    <div class="card bg-body-tertiary shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">{{ 'managedMailingLists'|trans }}</h2>
        </div>
        <div class="card-body">
            <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'address'|trans }}</th>
                            <th>{{ 'label'|trans }}</th>
                            <th class="text-end">{{ 'members'|trans }}</th>
                            <th class="text-end" data-orderable="false" data-searchable="false">{{ 'actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for list in lists %}
                        <tr>
                            <td class="font-monospace">{{ list.userIdentifier }}</td>
                            <td>{{ list.label }}</td>
                            <td class="text-end">{{ list.destinations|length }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('manage_list', {id: list.id}) }}">
                                    {{ ux_icon('mdi:account-multiple', {class: 'me-1'}) }} {{ 'manageList'|trans }}
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
