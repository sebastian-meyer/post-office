<nav class="ms-auto">
    <ul class="navbar-nav">
        {% if not is_granted('IS_AUTHENTICATED') %}
        <li class="nav-item">
            <a class="btn btn-outline-primary" href="{{ path('login') }}" title="{{ 'login'|trans }}">
                {{ ux_icon('mdi:login', {class: 'fs-4'}) }}
            </a>
        </li>
        {% else %}
        <li class="nav-item">
            <button class="btn btn-outline-danger" type="submit" form="logout" title="{{ 'logout'|trans }}">
                {{ ux_icon('mdi:logout', {class: 'fs-4'}) }}
            </button>
        </li>
        {% endif %}
    </ul>
</nav>
{% if is_granted('IS_AUTHENTICATED') %}
{# Logout buttons submit this form via their "form" attribute, so they also work inside other forms (e.g. on the login page). #}
<form id="logout" method="post" action="{{ path('_logout_main') }}" hidden>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
</form>
{% endif %}
