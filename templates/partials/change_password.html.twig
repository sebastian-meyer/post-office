{% block form %}
<input type="hidden" name="{{ field_name(form._token) }}" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
<input type="hidden" data-auth-target="email">
<div class="input-group has-validation mb-3">
    <input type="password" data-auth-target="password" data-action="focus->auth#onPasswordFocus blur->auth#onPasswordBlur" name="{{ field_name(form.currentPassword) }}" placeholder="{{ 'currentPassword'|trans }}" aria-label="{{ 'currentPassword'|trans }}" class="form-control{% if not form.currentPassword.vars.errors is empty %} is-invalid{% endif %}" required>
    <div class="invalid-feedback">
        {{ form_errors(form.currentPassword) }}
    </div>
</div>
<div class="input-group has-validation mb-3">
    <input type="password" data-auth-target="password" data-action="focus->auth#onPasswordFocus blur->auth#onPasswordBlur" name="{{ field_name(form.newPassword) }}" placeholder="{{ 'newPassword'|trans }}" aria-label="{{ 'newPassword'|trans }}" class="form-control{% if not form.newPassword.vars.errors is empty %} is-invalid{% endif %}" required>
    <div class="invalid-feedback">
        {{ form_errors(form.newPassword) }}
    </div>
</div>
<div class="input-group has-validation mb-3">
    <input type="password" data-auth-target="password" data-action="focus->auth#onPasswordFocus blur->auth#onPasswordBlur" name="{{ field_name(form.newPasswordRepeat) }}" placeholder="{{ 'newPasswordRepeat'|trans }}" aria-label="{{ 'newPasswordRepeat'|trans }}" class="form-control{% if not form.newPasswordRepeat.vars.errors is empty %} is-invalid{% endif %}" required>
    <button type="button" role="switch" data-auth-target="spy" data-action="focus->auth#onPasswordToggleFocus blur->auth#onPasswordToggleBlur click->auth#onPasswordToggleClick" data-bs-toggle="button" aria-label="{{ 'showPassword'|trans }}" class="btn btn-outline-secondary pe-4 showPasswordCheck"></button>
    <div class="invalid-feedback">
        {{ form_errors(form.newPasswordRepeat) }}
    </div>
</div>
{% if success %}
{{ include('components/alert-success.html.twig', {message: 'passwordChanged'}) }}
{% endif %}
{% endblock %}

{% block submit %}
<button type="submit" class="btn btn-primary">{{ ux_icon('mdi:password-reset', {class: 'fs-4 me-1'}) }} {{ 'changePassword'|trans }}</button>
{% endblock %}
