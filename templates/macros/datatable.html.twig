{#
    Attributes for a wrapper element that turns the <table> inside into a DataTable
    (see assets/controllers/datatable_controller.js).

    Usage:
        {% import 'macros/datatable.html.twig' as datatable %}
        <div {{ datatable.attributes({order: [[0, 'asc']]}) }}>
            <table class="table table-striped table-hover align-middle">...</table>
        </div>

    The attributes must not be put on the <table> itself (see the controller for why). The table must have a <thead>
    with one <th> per column, and no rows with colspan in <tbody>.
#}
{% macro attributes(options = {}) -%}
    data-controller="datatable"
    data-datatable-language-value="{{ {
        emptyTable: 'datatables.emptyTable'|trans,
        info: 'datatables.info'|trans,
        infoEmpty: 'datatables.infoEmpty'|trans,
        infoFiltered: 'datatables.infoFiltered'|trans,
        lengthMenu: 'datatables.lengthMenu'|trans,
        search: 'datatables.search'|trans,
        zeroRecords: 'datatables.zeroRecords'|trans,
        aria: {
            paginate: {
                first: 'datatables.first'|trans,
                previous: 'datatables.previous'|trans,
                next: 'datatables.next'|trans,
                last: 'datatables.last'|trans
            }
        }
    }|json_encode|e('html_attr') }}"
    {%- if options is not empty %} data-datatable-options-value="{{ options|json_encode|e('html_attr') }}"{% endif %}
{%- endmacro %}

{#
    Header cell with a checkbox that marks or unmarks all rows (matching the current search). The column must not be
    the one the table is ordered by.

    Usage: <th {{ datatable.select_column() }}>{{ datatable.select_all() }}</th>
#}
{% macro select_column() -%}
    class="text-center" style="width: 1%;" data-orderable="false" data-searchable="false"
{%- endmacro %}

{% macro select_all() -%}
    <input type="checkbox" class="form-check-input" data-datatable-target="all" data-action="datatable#toggleAll"
           title="{{ 'markAll'|trans }}" aria-label="{{ 'markAll'|trans }}">
{%- endmacro %}

{#
    Checkbox marking a row for the bulk actions (value: the value to submit, label: what the row is about).

    Usage: <td class="text-center">{{ datatable.select_row(account.id, account) }}</td>
#}
{% macro select_row(value, label) -%}
    <input type="checkbox" class="form-check-input" value="{{ value }}" data-datatable-row data-action="datatable#update"
           aria-label="{{ 'markEntry'|trans({'%name%': label ~ ''}) }}">
{%- endmacro %}

{#
    Counter of the marked rows, for the toolbar of the bulk actions.
#}
{% macro marked_count() -%}
    <span class="text-body-secondary">{{ 'markedEntries'|trans({'%count%': '<span data-datatable-target="count">0</span>'})|raw }}</span>
{%- endmacro %}
