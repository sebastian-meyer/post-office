# /etc/systemd/system/postfix-custom-policyd.service

# Runs the policy service for "members only" mailing lists (see postfix-custom-policyd.py).
# Postfix temporarily rejects all incoming emails while this service is not running!

[Unit]
Description=Postfix policy service for Post Office mailing lists
After=network.target mariadb.service
Before=postfix.service

[Service]
Type=simple
ExecStart=/usr/local/bin/postfix-custom-policyd.py
User=postfix
Group=postfix
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
