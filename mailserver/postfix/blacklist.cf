# /etc/postfix/sql/blacklist.cf

# Search for everything in square brackets. Replace those with the actual values for your setup.

user = vmail
password = [PASSWORD]
hosts = 127.0.0.1
dbname = vmail
query = SELECT action FROM blacklist WHERE (username='%u' OR username IS NULL) AND ('%d'=domain OR '%d' LIKE CONCAT('%%.',domain)) AND enabled=true ORDER BY username IS NULL LIMIT 1;
require_result_set = no
