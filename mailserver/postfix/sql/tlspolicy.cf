# /etc/postfix/sql/tlspolicy.cf

# Search for everything in square brackets. Replace those with the actual values for your setup.

user = vmail
password = [PASSWORD]
hosts = 127.0.0.1
dbname = vmail
query = SELECT CONCAT(policy,' ',params) AS tlspolicy FROM tlspolicies WHERE domain='%s' AND enabled=true;
require_result_set = no
