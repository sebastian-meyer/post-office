<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedVariablesAndParams="true"
    memoizeMethodCallResults="true"
    resolveFromConfigFile="true"
    reportMixedIssues="false"
    sealAllMethods="false"
>
    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/dev/App_KernelDevDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>
    <extraFiles>
        <directory name="var/cache/dev/Symfony/Config"/>
    </extraFiles>
    <issueHandlers>
        <!--
            Doctrine entities must not be final, because lazy-loading proxies extend them.
        -->
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src/Entity"/>
            </errorLevel>
        </ClassMustBeFinal>
        <!--
            Psalm does not analyze method bodies of classes extending Doctrine's ServiceEntityRepository, because it is
            declared conditionally (for ORM 2 and ORM 3). Therefore, usages inside repositories are not detected.
            PHPStan still analyzes the repositories completely.
        -->
        <UnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Repository"/>
            </errorLevel>
        </UnusedParam>
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Repository"/>
            </errorLevel>
        </PossiblyUnusedParam>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <!-- Used in AccountRepository::isAdminId() (see above). -->
                <referencedProperty name="App\Repository\AccountRepository::$adminIds"/>
            </errorLevel>
        </PossiblyUnusedProperty>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <!-- Used in AccountRepository::loadUserByIdentifier() and ::refreshUser() (see above). -->
                <referencedMethod name="App\Entity\Account::setAdmin"/>
                <!-- Magic getter, called implicitly when accessing @property-read properties. -->
                <referencedMethod name="App\Entity\Entity::__get"/>
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="var"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
